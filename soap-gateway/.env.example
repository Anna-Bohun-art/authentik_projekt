# Copy to .env for a local (non-Docker) run: `cp .env.example .env`
# In Docker these are supplied by docker-compose.yml / the repo-root .env.

GATEWAY_PORT=8000
LOG_LEVEL=info

# OAuth 2.0 resource-server settings — must match the authentik provider.
# (docs/authentik-setup.md walks through creating it.)
OIDC_ISSUER=http://localhost:9000/application/o/soap-gateway/
OIDC_JWKS_URI=http://localhost:9000/application/o/soap-gateway/jwks/
OIDC_AUDIENCE=soap-gateway

# "memory" needs no database; "postgres" uses the settings below.
USER_DIRECTORY=memory
PGHOST=localhost
PGPORT=5432
PGUSER=authentik
PGPASSWORD=authentik
PGDATABASE=soapdemo
