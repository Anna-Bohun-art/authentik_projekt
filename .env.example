# Copy to .env before `docker compose up`:  cp .env.example .env
# Generate strong values, e.g.:  openssl rand -hex 32

# --- PostgreSQL (shared by authentik and the soapdemo database) ---
PG_USER=authentik
PG_PASS=change-me-postgres-password
PG_DB=authentik

# --- authentik ---
AUTHENTIK_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-admin-password
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-bootstrap-api-token

# --- soap-gateway ---
LOG_LEVEL=info
