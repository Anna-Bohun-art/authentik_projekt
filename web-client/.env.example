# Copy to .env: `cp .env.example .env`
#
# Reuses the same authentik provider/client as client/.env (client ID
# "soap-gateway") — see docs/authentik-setup.md step 7 for the one extra
# setting that provider needs (a Redirect URI) before this will work.
PORT=3000
ISSUER=http://localhost:9001/application/o/soap-gateway/
AUTHORIZATION_ENDPOINT=http://localhost:9001/application/o/authorize/
TOKEN_ENDPOINT=http://localhost:9001/application/o/token/
JWKS_URI=http://localhost:9001/application/o/soap-gateway/jwks/
CLIENT_ID=soap-gateway
CLIENT_SECRET=paste-the-client-secret-from-authentik
REDIRECT_URI=http://localhost:3000/callback
GATEWAY_WSDL=http://localhost:8000/soap?wsdl
GATEWAY_ENDPOINT=http://localhost:8000/soap
